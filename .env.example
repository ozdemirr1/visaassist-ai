# Copy this file to .env and put real values only in .env.

# Reading document fields with a model (ADR 0007). Leave the key empty to run without it; the
# field form then offers manual entry only. In the prototype only synthetic SAMPLE documents may
# be read. Also set a monthly limit in the provider's dashboard; the API stops calling the model
# when its own log of this month's cost reaches MODEL_MONTHLY_BUDGET_USD.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5.4-mini
MODEL_MONTHLY_BUDGET_USD=20

# PostgreSQL: used by compose.yaml and by the backend.
POSTGRES_USER=visaassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visaassist
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://visaassist:change-me@localhost:5433/visaassist

# Session cookie (ADR 0004): keep true; false only if a browser refuses Secure cookies on
# http://localhost during development.
COOKIE_SECURE=true

# Uploaded documents (ADR 0005). Generate the key with either of:
#   cd backend && uv run python -m app.storage.new_key
#   openssl rand -base64 32
# Keep it only in .env; losing it makes every stored document unreadable.
DOCUMENT_MASTER_KEY=
DOCUMENT_KEY_ID=k1
# Where encrypted files are stored; default: storage/ in the repository root (not committed).
# STORAGE_DIR=

# Whole system with Docker (`docker compose --profile app up --build`): the web client's port,
# and the demo account (demo@visaassist.example), which is reset on every start of the API
# container while LOAD_DEMO=true. Without DEMO_PASSWORD a random password is printed once in
# the API's log when the account is created.
WEB_PORT=8080
LOAD_DEMO=true
DEMO_PASSWORD=
