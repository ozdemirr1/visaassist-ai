# Copy this file to .env and put real values only in .env.
OPENAI_API_KEY=

# PostgreSQL: used by compose.yaml and by the backend.
POSTGRES_USER=visaassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visaassist
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://visaassist:change-me@localhost:5433/visaassist

# Session cookie (ADR 0004): keep true; false only if a browser refuses Secure cookies on
# http://localhost during development.
COOKIE_SECURE=true

# Uploaded documents (ADR 0005). Generate the key with:
#   cd backend && uv run python -m app.storage.new_key
# Keep it only in .env; losing it makes every stored document unreadable.
DOCUMENT_MASTER_KEY=
DOCUMENT_KEY_ID=k1
# Where encrypted files are stored; default: storage/ in the repository root (not committed).
# STORAGE_DIR=
